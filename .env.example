# Copy to .env and fill in. Real environment variables always win over this file.
# Every key is optional: with none set, the API serves cached samples and the evals
# replay the committed LLM cache.

# https://console.groq.com/keys (free tier, no card)
GROQ_API_KEY=

# https://aistudio.google.com/apikey (free tier; used for Gemma)
GEMINI_API_KEY=

# Local models for bulk evals (Ollama's OpenAI-compatible endpoint).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Comma-separated origins allowed to call the API (the deployed frontend, exactly).
CORS_ORIGINS=http://localhost:5180
